<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.welivethisway.dialer"
    android:versionCode="15"
    android:versionName="1.10.4">

    <!-- Only permission the app needs: talk to the CRM server.
         No CALL_PHONE permission on purpose — the app only ever
         opens the system dialer (ACTION_DIAL) and the operator taps Call. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="WLTW Dialer"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="WLTW Dialer Settings" />
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="WLTW Dialer About" />
        <activity
            android:name=".QueueActivity"
            android:exported="false"
            android:label="WLTW Dialer Queue" />
    </application>

</manifest>
